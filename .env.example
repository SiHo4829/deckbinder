# 이 파일은 템플릿이다. 실제 값은 .env.local에 넣는다 (.gitignore 대상).
# 시크릿을 추적되는 파일(.gitignore, README, 소스)에 절대 적지 않는다.

# ─── T1.4 Supabase ───────────────────────────────────────────
# Supabase 대시보드 → Project Settings → API 에서 확인
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# service_role 키는 RLS를 우회한다. 서버 전용이며 NEXT_PUBLIC_ 접두사를 붙이지 말 것
SUPABASE_SERVICE_ROLE_KEY=

# 로컬 CLI 전용 (supabase link / db push). 앱 런타임은 쓰지 않는다.
# Supabase 대시보드 -> Project Settings -> Database -> Database password
SUPABASE_DB_PASSWORD=

# 사이트 절대 URL (OG 이미지 · sitemap · OAuth 리다이렉트)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 관리자 화면 토큰 (16자 이상). T3.1 정식 인증 전까지 임시 수단
ADMIN_TOKEN=

# 구글 애드센스 퍼블리셔 ID (ca-pub-...). 승인 후에 채운다.
# 값이 없으면 광고를 렌더하지 않는다.
NEXT_PUBLIC_ADSENSE_CLIENT=

# ─── T2.9 크롤러 (해당 태스크에서 활성화) ──────────────────────
# CRAWLER_WORKER_URL=
# CRAWLER_SHARED_SECRET=
# IP_HASH_SALT=
